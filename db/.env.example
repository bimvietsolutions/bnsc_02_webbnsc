# Kết nối PostgreSQL cho Prisma (sao chép thành .env ở thư mục gốc dự án)
# Định dạng: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://bnsc:bnsc_secret@localhost:5432/bnsc?schema=public"

# Khóa ký JWT cho phiên đăng nhập admin (ĐỔI thành chuỗi ngẫu nhiên dài).
JWT_SECRET="doi-thanh-chuoi-bi-mat-ngau-nhien-that-dai"

# Cách tạo admin đầu tiên (khuyến nghị):
#   npm run db:create-admin -- admin@bacnam.com.vn MatKhauManh123 "Quản trị viên"
#
# (Tùy chọn) Hoặc tạo admin ngay khi seed bằng 2 biến dưới:
# ADMIN_EMAIL="admin@bacnam.com.vn"
# ADMIN_PASSWORD_HASH=""   # sinh bằng: node -e "console.log(require('bcryptjs').hashSync('MatKhau',10))"
