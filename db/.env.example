# Kết nối PostgreSQL cho Prisma (sao chép thành .env ở thư mục gốc dự án)
# Định dạng: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://bnsc:bnsc_secret@localhost:5432/bnsc?schema=public"

# (Tùy chọn) Tạo tài khoản admin khi seed.
# Sinh hash bằng bcrypt, ví dụ:
#   node -e "console.log(require('bcryptjs').hashSync('MatKhauManh', 10))"
ADMIN_EMAIL="admin@bacnam.com.vn"
ADMIN_PASSWORD_HASH=""
