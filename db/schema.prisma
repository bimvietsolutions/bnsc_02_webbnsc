// =============================================================================
// BNSC – Bắc Nam Software | Prisma schema (PostgreSQL)
// Cấu trúc CSDL tập trung toàn bộ nội dung website + dữ liệu vận hành (lead,
// admin). Đây là "nguồn sự thật" (source of truth); chạy `prisma migrate` để
// sinh SQL migration trong db/migrations.
//
// Quy ước:
//  - sortOrder: thứ tự hiển thị (nhỏ hơn = trước).
//  - isActive / isPublished: bật/tắt hiển thị mà không cần xóa (soft toggle).
//  - dateText: giữ nguyên chuỗi ngày đang hiển thị (vd "18 Thg 5, 2026").
//    publishedAt: mốc thời gian thật để sắp xếp/lọc (điền dần sau).
//  - metaTitle/metaDescription/ogImage: ghi đè SEO cho từng bài (tùy chọn).
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------- Cấu hình site -------------------------------
// Key-value linh hoạt: tên công ty, hotline, email, địa chỉ, phiên bản phần
// mềm, nội dung thanh thông báo, liên kết mạng xã hội, prompt hệ thống AI...
model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String   @db.Text
  group     String? // 'general' | 'contact' | 'social' | 'announcement' | 'ai'
  label     String?
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ------------------------------- Điều hướng ----------------------------------
// Vừa dùng cho menu chính, vừa cho submenu (parentId trỏ về mục cha "Phần mềm").
model NavLink {
  id        Int       @id @default(autoincrement())
  name      String
  href      String // "#tin-tuc", "/thu-vien"...
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  parentId  Int?
  parent    NavLink?  @relation("NavChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  NavLink[] @relation("NavChildren")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([parentId])
  @@map("nav_links")
}

// ------------------------------- Hero (trang chủ) ----------------------------
model HeroSlide {
  id        Int      @id @default(autoincrement())
  imageUrl  String
  caption   String
  linkUrl   String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("hero_slides")
}

model HeroStat {
  id        Int     @id @default(autoincrement())
  value     String // "63", "v1.20"
  label     String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  @@map("hero_stats")
}

// ------------------------------- Sản phẩm & dịch vụ --------------------------
model Product {
  id         Int      @id @default(autoincrement())
  slug       String   @unique
  name       String
  isFeatured Boolean  @default(false)
  badge      String?
  tagline    String   @db.Text
  features   String[] // danh sách tính năng
  ctaText    String
  iconName   String // tên icon lucide
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("products")
}

// ------------------------------- Tin tức -------------------------------------
model NewsCategory {
  id        Int           @id @default(autoincrement())
  slug      String        @unique
  name      String        @unique
  sortOrder Int           @default(0)
  articles  NewsArticle[]

  @@map("news_categories")
}

model NewsArticle {
  id              Int          @id @default(autoincrement())
  slug            String       @unique
  title           String
  excerpt         String       @db.Text
  contentBody     String       @db.Text
  imageUrl        String?
  author          String?      @default("Ban Biên Tập BNSC")
  categoryId      Int
  category        NewsCategory @relation(fields: [categoryId], references: [id])
  dateText        String? // chuỗi ngày hiển thị hiện tại
  publishedAt     DateTime?    @default(now())
  views           Int          @default(0)
  isPublished     Boolean      @default(true)
  metaTitle       String?
  metaDescription String?      @db.Text
  ogImage         String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([categoryId])
  @@index([isPublished, publishedAt])
  @@map("news_articles")
}

// ------------------------------- Thư viện hướng dẫn --------------------------
model LibraryCategory {
  id        Int              @id @default(autoincrement())
  slug      String           @unique
  name      String           @unique
  sortOrder Int              @default(0)
  articles  LibraryArticle[]

  @@map("library_categories")
}

model LibraryArticle {
  id              Int             @id @default(autoincrement())
  slug            String          @unique
  title           String
  summary         String          @db.Text
  content         String?         @db.Text // nội dung chi tiết (điền dần)
  imageUrl        String?
  videoUrl        String?
  author          String?
  categoryId      Int
  category        LibraryCategory @relation(fields: [categoryId], references: [id])
  dateText        String?
  publishedAt     DateTime?       @default(now())
  views           Int             @default(0)
  attachmentUrl   String?
  attachmentName  String?
  attachmentSize  String?
  isPublished     Boolean         @default(true)
  metaTitle       String?
  metaDescription String?         @db.Text
  ogImage         String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([categoryId])
  @@index([isPublished, publishedAt])
  @@map("library_articles")
}

// ------------------------------- Khách hàng ----------------------------------
model Customer {
  id        Int     @id @default(autoincrement())
  name      String
  subtext   String?
  logoUrl   String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  @@map("customers")
}

// ------------------------------- Tư vấn & Đào tạo ----------------------------
model ConsultingService {
  id          Int     @id @default(autoincrement())
  title       String
  description String  @db.Text
  iconName    String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  @@map("consulting_services")
}

model Course {
  id           Int      @id @default(autoincrement())
  slug         String   @unique
  title        String
  scheduleText String? // "Khai giảng ngày 15 hằng tháng"
  duration     String?
  format       String? // hình thức học ("Trực tiếp & Zoom")
  price        String?
  coupon       String?
  slots        String?
  trainer      String?
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("courses")
}

// ------------------------------- FAQ -----------------------------------------
model Faq {
  id        Int      @id @default(autoincrement())
  scope     FaqScope @default(HOME)
  question  String   @db.Text
  answer    String   @db.Text
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)

  @@index([scope])
  @@map("faqs")
}

enum FaqScope {
  HOME
  SUPPORT
}

// ------------------------------- Hỗ trợ kỹ thuật -----------------------------
model SupportStaff {
  id        Int     @id @default(autoincrement())
  name      String
  phone     String
  role      String?
  ext       String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  @@map("support_staff")
}

model RemoteTool {
  id          Int     @id @default(autoincrement())
  name        String
  description String  @db.Text
  version     String?
  url         String
  realUrl     String?
  badge       String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  @@map("remote_tools")
}

// ------------------------------- Lead (form đăng ký) -------------------------
// Lưu dữ liệu người dùng gửi từ modal Tải/Đăng ký/Tư vấn để admin theo dõi.
model Lead {
  id          Int        @id @default(autoincrement())
  type        LeadType   @default(REGISTER)
  fullName    String
  phone       String
  email       String?
  province    String?
  company     String?
  productSlug String?
  courseSlug  String?
  note        String?    @db.Text
  source      String? // trang/nút phát sinh lead
  status      LeadStatus @default(NEW)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([type, status])
  @@index([createdAt])
  @@map("leads")
}

enum LeadType {
  DOWNLOAD
  REGISTER
  CONSULT
}

enum LeadStatus {
  NEW
  CONTACTED
  DONE
  SPAM
}

// ------------------------------- Chat AI (tùy chọn) --------------------------
model ChatMessage {
  id        Int      @id @default(autoincrement())
  sessionId String?
  role      String // 'user' | 'model'
  text      String   @db.Text
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@map("chat_messages")
}

// ------------------------------- Quản trị viên -------------------------------
model AdminUser {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  name         String?
  role         AdminRole @default(EDITOR)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("admin_users")
}

enum AdminRole {
  ADMIN
  EDITOR
}

// ------------------------------- Media (tùy chọn) ----------------------------
// Sổ đăng ký tài nguyên upload (ảnh bài viết, logo, file PDF...).
model Media {
  id        Int      @id @default(autoincrement())
  url       String
  alt       String?
  mimeType  String?
  sizeBytes Int?
  createdAt DateTime @default(now())

  @@map("media")
}

// =============================================================================
// NỘI DUNG HỢP NHẤT (migration từ website cũ bacnam.com.vn)
// -----------------------------------------------------------------------------
// Thay cho cặp News*/Library* rời rạc: một model Article duy nhất, phân biệt
// bằng `section`, kèm Category dạng cây, Tag, SeriesNode (mục lục giáo trình)
// và Redirect (301 từ URL cũ). Xem plan/07-ke-hoach-migration-du-lieu-cu.md.
// Các model news_articles / library_articles cũ được giữ tới khi cutover xong.
// =============================================================================

enum ContentSection {
  NEWS // Tin tức
  LIBRARY // Thư viện hướng dẫn (Dự toán BNSC)
  CONSULTING // Tư vấn kinh tế xây dựng
  TRAINING // Đào tạo nghiệp vụ
}

// Danh mục dạng cây: node gốc = "mảng" (Tin tức, Dự toán BNSC...), node con =
// danh mục thật gắn bài viết. `section` được nhân bản xuống con để lọc 1 bước.
model Category {
  id             Int            @id @default(autoincrement())
  slug           String         @unique
  name           String
  title          String? // tiêu đề dùng cho SEO của trang danh mục
  section        ContentSection
  parentId       Int?
  parent         Category?      @relation("CatTree", fields: [parentId], references: [id])
  children       Category[]     @relation("CatTree")
  description    String?        @db.Text
  keywords       String?
  color          String? // mã màu nhãn (#ff0000)
  emoji          String? // biểu tượng tab ở Thư viện
  sortOrder      Int            @default(0)
  showOnMenu     Boolean        @default(true)
  showAtHomepage Boolean        @default(false)
  isActive       Boolean        @default(true)
  articles       Article[]
  legacyId       Int?           @unique // categories.id của site cũ

  @@index([section, sortOrder])
  @@index([parentId])
  @@map("categories")
}

model Article {
  id          Int            @id @default(autoincrement())
  slug        String         @unique // = posts.title_slug (đã kiểm tra không trùng)
  title       String
  summary     String?        @db.Text // rỗng -> tự sinh từ contentText khi import
  /// HTML đã sanitize + rewrite URL ảnh về /uploads/legacy/...
  contentHtml String?        @db.Text
  /// Bản text thuần của contentHtml, dùng cho tìm kiếm và sinh summary
  contentText String?        @db.Text
  section     ContentSection
  categoryId  Int?
  category    Category?      @relation(fields: [categoryId], references: [id])

  coverUrl       String? // ảnh lớn (posts.image_default)
  thumbUrl       String? // ảnh nhỏ danh sách (posts.image_mid)
  coverAlt       String?
  videoUrl       String?
  embedHtml      String? @db.Text // posts.video_embed_code
  attachmentUrl  String?
  attachmentName String?
  attachmentSize String?

  author          String?
  publishedAt     DateTime? // = posts.created_at
  sourceUpdatedAt DateTime? // = posts.updated_at
  dateText        String? // ghi đè chuỗi ngày hiển thị (tùy chọn)
  views           Int       @default(0)

  isPublished   Boolean @default(true)
  isFeatured    Boolean @default(false)
  isRecommended Boolean @default(false)
  isBreaking    Boolean @default(false)
  isSlider      Boolean @default(false)
  sliderOrder   Int     @default(0)

  metaTitle       String?
  metaDescription String? @db.Text
  metaKeywords    String?
  ogImage         String?
  canonicalUrl    String? // = posts.optional_url

  tags        Tag[]        @relation("ArticleTags")
  seriesNodes SeriesNode[]

  legacyId   Int?     @unique // posts.id
  legacyPath String? // "/<title_slug>" — đường dẫn gốc trên site cũ
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([section, isPublished, publishedAt])
  @@index([categoryId])
  @@index([isSlider, sliderOrder])
  @@index([publishedAt])
  @@map("articles")
}

model Tag {
  id        Int       @id @default(autoincrement())
  slug      String    @unique
  name      String
  articles  Article[] @relation("ArticleTags")
  createdAt DateTime  @default(now())

  @@map("tags")
}

// Mục lục giáo trình "DỰ TOÁN BNSC": cây Phần I..V -> từng bài học có thứ tự.
// Node không gắn articleId là mục đang để trống (placeholder) ở site cũ.
model SeriesNode {
  id        Int          @id @default(autoincrement())
  title     String
  slug      String
  parentId  Int?
  parent    SeriesNode?  @relation("SeriesTree", fields: [parentId], references: [id])
  children  SeriesNode[] @relation("SeriesTree")
  articleId Int?
  article   Article?     @relation(fields: [articleId], references: [id], onDelete: SetNull)
  sortOrder Int          @default(0)
  isActive  Boolean      @default(true)
  legacyId  Int?         @unique

  @@index([parentId, sortOrder])
  @@index([articleId])
  @@map("series_nodes")
}

// Bảng 301: giữ thứ hạng SEO của các URL gốc cũ dạng bacnam.com.vn/<slug>.
model Redirect {
  id        Int      @id @default(autoincrement())
  from      String   @unique // "/vinh-long-quyet-dinh-325-va-327qd-sxd..."
  to        String // "/tin-tuc/vinh-long-quyet-dinh-325-va-327qd-sxd..."
  status    Int      @default(301)
  hits      Int      @default(0)
  createdAt DateTime @default(now())

  @@map("redirects")
}
