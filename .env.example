# Runtime
NODE_ENV=production
PORT=3000

# Public application URL
APP_URL=https://your-domain.example.com

# Optional. Without this key, the AI chat endpoint runs in offline mode.
GEMINI_API_KEY=

# Bí mật ký JWT phiên đăng nhập admin (bắt buộc đặt ở production).
JWT_SECRET=

# Đăng nhập admin bằng Google (tùy chọn). Tạo OAuth 2.0 Client ID (loại "Web
# application") tại https://console.cloud.google.com/apis/credentials và thêm
# origin của trang admin vào "Authorized JavaScript origins".
# Bỏ trống -> nút đăng nhập Google tự ẩn, chỉ còn đăng nhập bằng mật khẩu.
GOOGLE_CLIENT_ID=

# Cho phép Google lập chỉ mục tên miền này. Mặc định TẮT.
# Trong lúc chuyển đổi, website chạy song song trên tên miền demo và tên miền
# chính thức; chỉ bật "true" trên tên miền chính thức, nếu không sẽ có 555 trang
# trùng nội dung cạnh tranh nhau trên Google.
SITE_INDEXABLE=false

# CSDL PostgreSQL. Trên máy lập trình, dựng bằng:
#   POSTGRES_PORT=5434 docker compose -f db/docker-compose.yml up -d
# Đổi cổng khi máy đã có Postgres của dự án khác chiếm 5432 — cổng trong
# DATABASE_URL phải trùng POSTGRES_PORT.
DATABASE_URL="postgresql://bnsc:bnsc_secret@localhost:5434/bnsc?schema=public"
